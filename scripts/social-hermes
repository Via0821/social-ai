#!/usr/bin/env bash
# ============================================================
# social-hermes — run Hermes against SOCIAL's project-local home.
#
# Guarantees every invocation uses Social-ai/.hermes and never the
# developer's personal ~/.hermes profile.
#
# Usage:  ./scripts/social-hermes <hermes args...>
# ============================================================
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PROJECT_ROOT
export HERMES_HOME="$PROJECT_ROOT/.hermes"

mkdir -p "$HERMES_HOME"

# Load SOCIAL environment (secrets) if present. Never echoed.
if [[ -f "$PROJECT_ROOT/.env" ]]; then
  set -o allexport
  # shellcheck disable=SC1091
  source "$PROJECT_ROOT/.env"
  set +o allexport
fi

HERMES_BIN="${HERMES_BIN:-$(command -v hermes || true)}"
if [[ -z "$HERMES_BIN" ]]; then
  echo "ERROR: 'hermes' not found on PATH." >&2
  echo "Install Hermes Agent, or set HERMES_BIN to its absolute path." >&2
  exit 127
fi

# Put Hermes' own venv first on PATH, matching what the systemd gateway unit
# does. Without this the agent's terminal tool resolves python3 to the system
# 3.8, which has none of Hermes' libraries — the Google Sheets skill then
# fails on import and the agent quietly falls back to scraping the sheet over
# the public web. That works only for link-shared sheets and bypasses OAuth
# entirely, so a private sheet would fail with no obvious cause.
#
# Resolved from the hermes entry point rather than hard-coded, so this stays
# correct on the production host.
# Hermes ships its interpreter in its own venv. How `hermes` points at it
# differs by install: a symlink straight into venv/bin on some hosts, a small
# wrapper script that execs it on others. Resolve both, and fall back to
# asking hermes itself where it lives, rather than silently landing on the
# system python — which has none of the dependencies.
_resolve_hermes_python() {
  local bin candidate dir
  bin="$(command -v hermes || true)"
  [[ -n "$bin" ]] || return 1

  # (a) symlink into venv/bin
  dir="$(dirname "$(readlink -f "$bin")")"
  for candidate in "$dir/python3" "$dir/python"; do
    [[ -x "$candidate" ]] && { echo "$candidate"; return 0; }
  done

  # (b) wrapper script naming the interpreter
  candidate="$(grep -oE '/[^"]*/venv/bin/python[0-9.]*' "$bin" 2>/dev/null | head -1)"
  [[ -n "$candidate" && -x "$candidate" ]] && { echo "$candidate"; return 0; }

  # (c) ask hermes where it is installed
  dir="$("$bin" --version 2>/dev/null | sed -n 's/^Install directory:[[:space:]]*//p' | head -1)"
  for candidate in "$dir/venv/bin/python3" "$dir/venv/bin/python"; do
    [[ -x "$candidate" ]] && { echo "$candidate"; return 0; }
  done
  return 1
}

_HERMES_PY="$(_resolve_hermes_python || true)"
if [[ -n "$_HERMES_PY" ]]; then
  export PATH="$(dirname "$_HERMES_PY"):$PATH"
fi

exec "$HERMES_BIN" "$@"
