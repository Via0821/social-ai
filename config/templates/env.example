# ============================================================
# SOCIAL — environment template
# Copy to .env and fill in. NEVER commit the real .env.
#   cp .env.example .env && chmod 600 .env
# ============================================================

# --- LLM provider (required) ---
OPENAI_API_KEY=sk-...

# --- LINE Messaging API (required for the LINE phase) ---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Owner's LINE userId (starts with 'U'). Used to lock the bot to one owner.
LINE_OWNER_USER_ID=

# --- Google (OAuth2 only — password authentication is prohibited) ---
# Not a secret: identifies which account to authorize for Sheets.
GOOGLE_ACCOUNT_EMAIL=

# --- Optional: future provider switch ---
# ANTHROPIC_API_KEY=
